# =============================================================
# Revenue Recovery Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real secrets.
# =============================================================

# ─── Database ────────────────────────────────────────────────
# Local dev default matches docker-compose.yml
DATABASE_URL="postgresql://revenue:revenue_dev_secret@localhost:5432/revenue_recovery"

# ─── Redis ───────────────────────────────────────────────────
# Local dev default matches docker-compose.yml
REDIS_URL="redis://:redis_dev_secret@localhost:6379"

# ─── Anthropic (Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Razorpay (test mode) ────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET="..."

# ─── Resend (email) ──────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="recovery@yourdomain.com"

# ─── Twilio (SMS / WhatsApp) ─────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM_NUMBER="+1..."          # Twilio sandbox number
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"  # Twilio sandbox

# ─── NextAuth ────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── Business logic config ───────────────────────────────────
# Cases with amountAtRisk above this (INR paise) require human approval
HIGH_VALUE_APPROVAL_THRESHOLD=50000

# ─── App environment ─────────────────────────────────────────
NODE_ENV="development"
